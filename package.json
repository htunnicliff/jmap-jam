{
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "lint": "oxlint",
    "test": "pnpm -r test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "spelling:check": "cspell .",
    "version": "pnpm run build && changeset version && pnpm install",
    "publish": "pnpm run build && pnpm publish --recursive --access public",
    "sync:readme": "cp packages/jmap-jam/README.md README.md"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "24.13.3",
    "cspell": "10.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "0.25.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.21.0"
}
