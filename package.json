  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.13.4",
    "cspell": "10.3.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.4.1"
}
